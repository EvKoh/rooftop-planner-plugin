    "build-glyphs": "node scripts/build-glyphs.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "playwright": "^1.63.0",
    "trek-plugin-sdk": "^1.7.0",
    "vitest": "^3.2.4"
  }
