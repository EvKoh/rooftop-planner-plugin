{
  "name": "vanlife",
  "version": "0.6.14",
  "private": true,
  "description": "TREK plugin: road trips with a rooftop tent, a campervan or a motorhome (MCP tools, warnings, route profiles, amenities widget).",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "trek-plugin-sdk dev",
    "validate": "trek-plugin-sdk validate",
