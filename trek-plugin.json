{
  "id": "vanlife",
  "name": "Vanlife Planner",
  "version": "0.2.0",
  "apiVersion": 1,
  "author": "EvKoh",
  "description": "Road trips with a rooftop tent, a campervan or a motorhome: legal nights, sunset-safe arrivals, routes, schedules and amenities, as MCP tools.",
  "homepage": "https://github.com/EvkohLand/TrekPluginVanlife",
  "license": "MIT",
  "tags": [
    "vanlife",
    "camping",
    "rooftop-tent",
    "campervan",
    "motorhome",
    "mcp"
  ],
  "type": "widget",
  "trek": ">=4.0.0 <5.0.0",
  "nativeModules": false,
  "icon": "Caravan",
  "permissions": [
    "db:own",
    "db:read:trips",
    "db:read:categories",
    "db:read:costs",
    "db:read:todos",
    "db:write:places",
    "db:write:itinerary",
    "db:meta",
    "mcp:tools",
    "hook:trip-warning-provider",
    "hook:route-provider",
    "hook:table-contributor",
    "http:outbound:valhalla1.openstreetmap.de",
    "http:outbound:overpass-api.de",
    "http:outbound:park4night.com"
  ],
  "egress": [
    "valhalla1.openstreetmap.de",
    "overpass-api.de",
    "park4night.com"
  ],
  "requiredAddons": [],
  "pluginDependencies": [],
  "settings": [
    {
      "key": "vehicle",
      "label": "Vehicle",
      "scope": "user",
      "input_type": "select",
      "default": "rooftop_tent",
      "options": [
        {
          "value": "rooftop_tent",
          "label": "Car with a rooftop tent"
        },
        {
          "value": "campervan",
          "label": "Campervan (bed inside)"
        },
        {
          "value": "motorhome",
          "label": "Motorhome"
        }
      ],
      "hint": "Decides which nights are legal: opening a rooftop tent is camping; sleeping inside a van without deploying anything is parking."
    },
    {
      "key": "vehicle_height_m",
      "label": "Vehicle height (m)",
      "scope": "user",
      "input_type": "number",
      "default": 1.95
    },
    {
      "key": "vehicle_length_m",
      "label": "Vehicle length (m)",
      "scope": "user",
      "input_type": "number",
      "default": 4.8
    },
    {
      "key": "vehicle_weight_t",
      "label": "Vehicle weight (t)",
      "scope": "user",
      "input_type": "number",
      "default": 2
    },
    {
      "key": "dog",
      "label": "Travelling with a dog",
      "scope": "user",
      "input_type": "checkbox",
      "default": true
    },
    {
      "key": "travellers",
      "label": "Number of travellers (for prices per person)",
      "scope": "user",
      "input_type": "number",
      "default": 2
    },
    {
      "key": "night_price_target",
      "label": "Target price per night",
      "scope": "user",
      "input_type": "number",
      "default": 25
    },
    {
      "key": "night_price_max",
      "label": "Price ceiling per night (above: justify or find an alternative)",
      "scope": "user",
      "input_type": "number",
      "default": 35
    },
    {
      "key": "sunset_margin_min",
      "label": "Arrive at the night at least this many minutes before sunset",
      "scope": "user",
      "input_type": "number",
      "default": 60
    },
    {
      "key": "water_reserve_l",
      "label": "Water reserve (litres)",
      "scope": "user",
      "input_type": "number",
      "default": 20
    },
    {
      "key": "fuel_l_per_100km",
      "label": "Fuel consumption (L/100 km)",
      "scope": "user",
      "input_type": "number",
      "default": 6.1
    },
    {
      "key": "fuel_price_per_l",
      "label": "Fuel price per litre",
      "scope": "user",
      "input_type": "number",
      "default": 1.9
    },
    {
      "key": "highway_days",
      "label": "Motorway (tolls) allowed",
      "scope": "user",
      "input_type": "select",
      "default": "first_last",
      "options": [
        {
          "value": "first_last",
          "label": "First and last day only"
